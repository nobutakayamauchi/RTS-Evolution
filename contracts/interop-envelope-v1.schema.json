{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nobutakayamauchi/RTS-Evolution/contracts/interop-envelope-v1.schema.json",
  "title": "RTS Interop Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_type",
    "artifact_id",
    "created_at",
    "producer",
    "subject",
    "state",
    "evidence_refs",
    "authority",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "const": "rts-interop/v1"
    },
    "artifact_type": {
      "enum": [
        "UNIT",
        "RESULT",
        "EVIDENCE",
        "GATE_RESULT",
        "RETRY_REQUEST",
        "APPROVAL",
        "TRACE",
        "LEARNING_CANDIDATE",
        "PROMOTION_DECISION",
        "FREEZE_RECORD"
      ]
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": ["string", "null"]
        },
        "commit": {
          "type": ["string", "null"]
        },
        "runtime_identity": {
          "type": ["object", "null"],
          "additionalProperties": true
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_artifact_ids"],
      "properties": {
        "unit_id": {
          "type": ["string", "null"]
        },
        "target_artifact_id": {
          "type": ["string", "null"]
        },
        "target_identity": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "parent_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "intended_consumers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "PROPOSED",
        "READY",
        "FINAL",
        "BLOCKED",
        "UNKNOWN",
        "CONFLICT"
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNKNOWN",
        "CONFLICT",
        "HUMAN_REQUIRED"
      ]
    },
    "disposition": {
      "enum": [
        "PROMOTE",
        "REJECT",
        "DEFER",
        "QUARANTINE",
        "NEEDS_MORE_EVIDENCE"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": ["string", "null"]
              },
              "identity": {
                "type": ["object", "null"],
                "additionalProperties": true
              }
            }
          }
        ]
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "external_action", "promotion"],
      "properties": {
        "execution": {
          "type": "boolean"
        },
        "external_action": {
          "type": "boolean"
        },
        "promotion": {
          "type": "boolean"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_type": {"const": "GATE_RESULT"}
        },
        "required": ["artifact_type"]
      },
      "then": {
        "required": ["verdict"]
      },
      "else": {
        "not": {
          "required": ["verdict"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {"const": "PROMOTION_DECISION"}
        },
        "required": ["artifact_type"]
      },
      "then": {
        "required": ["disposition"]
      },
      "else": {
        "not": {
          "required": ["disposition"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {"const": "APPROVAL"}
        },
        "required": ["artifact_type"]
      },
      "then": {
        "properties": {
          "subject": {
            "anyOf": [
              {
                "required": ["target_artifact_id"],
                "properties": {
                  "target_artifact_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "required": ["target_identity"],
                "properties": {
                  "target_identity": {
                    "type": "object",
                    "minProperties": 1
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
